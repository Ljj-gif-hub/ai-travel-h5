# ============================================================
# Agent 旅游规划服务 — 环境变量配置
# 复制为 .env 并填写实际值
# ============================================================

# ---- LLM 配置（与 Spring Boot 后端共用，格式兼容） ----
# 支持任意 OpenAI 兼容接口：DeepSeek / OpenAI / 通义千问 / Kimi / 自定义代理
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash
# 如果 LLM 需要额外的 HTTP 请求头（如 Claude 的 x-api-key），在这里配置 JSON
# LLM_EXTRA_HEADERS={"x-api-key":"...","anthropic-version":"2023-06-01"}

# ---- LLM 备用模型（自动降级，可选）----
# 三个变量全部配置才启用：primary 连续 3 次失败冷却 60 秒期间改走 fallback；
# 429/5xx/网络异常也会即时降级。可指向另一个供应商（如 OpenAI/通义千问）。
# LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_FALLBACK_API_KEY=sk-fallback-key-here
# LLM_FALLBACK_MODEL=qwen-plus

# ---- Tavily 联网搜索（用于获取实时景点/酒店/美食信息）----
# 免费额度：1000次/月，注册地址：https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# ---- 高德地图 Web API（用于计算通勤距离/时间）----
# 注册地址：https://lbs.amap.com → 创建应用 → Web服务
AMAP_WEB_KEY=your-amap-web-key-here

# ---- 服务配置 ----
AGENT_PORT=3201
# Agent 服务鉴权（安全）：所有 /api/agent/* 请求必须携带共享密钥或有效 JWT
# 后端 AgentProxyController 透传时会附加 X-Agent-Key；两端需配置一致
AGENT_API_KEY=change-me-shared-secret
# JWT 校验密钥（可选）：与后端 JWT_SECRET 一致时，Agent 可从 JWT 提取并绑定 user_id，防伪造
AGENT_JWT_SECRET=
# 是否在前端展示 Agent 思考过程（开发环境建议 true）
SHOW_THINKING=true
# 强制 Demo 模式（无需 LLM API Key，使用内置 8 城数据）。
# 未配置 LLM_API_KEY 时也会自动进入 Demo 模式，一般无需显式设置。
# DEMO_MODE=true

# ---- 工具权限控制（Permission）----
# open（默认，全部允许）| blocklist（黑名单）| allowlist（白名单）
# PERMISSION_MODE=open
# 白名单：仅允许下列工具被 Agent 调用（逗号分隔，名称见 /api/agent/permissions）
# TOOL_ALLOWLIST=search_attractions_info,search_hotels_info,get_commute_info,calculate_budget
# 黑名单：禁止下列工具被 Agent 调用
# TOOL_BLOCKLIST=calculate_budget

# ---- MCP 客户端（接入外部 MCP 服务器工具）----
# MCP_ENABLED=true
# 逗号分隔的 MCP 服务器，格式：名字=URL（streamable-http，端点一般为 /mcp）
# MCP_CLIENT_SERVERS=weather=http://localhost:9000/mcp,demo=http://localhost:9001/mcp

# ---- MCP 服务端（把本 Agent 工具暴露为 MCP，供其他客户端调用）----
# MCP_SERVER_ENABLED=true
# 传输方式：streamable-http（默认）/ sse
# MCP_SERVER_TRANSPORT=streamable-http
# MCP_SERVER_HOST=0.0.0.0
# MCP_SERVER_PORT=3202
