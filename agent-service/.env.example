# ============================================================
# Agent 旅游规划服务 — 环境变量配置
# 复制为 .env 并填写实际值
# ============================================================

# ---- LLM 配置（与 Spring Boot 后端共用，格式兼容） ----
# 支持任意 OpenAI 兼容接口：DeepSeek / OpenAI / 通义千问 / Kimi / 自定义代理
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash
# 如果 LLM 需要额外的 HTTP 请求头（如 Claude 的 x-api-key），在这里配置 JSON
# LLM_EXTRA_HEADERS={"x-api-key":"...","anthropic-version":"2023-06-01"}

# ---- Tavily 联网搜索（用于获取实时景点/酒店/美食信息）----
# 免费额度：1000次/月，注册地址：https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# ---- 高德地图 Web API（用于计算通勤距离/时间）----
# 注册地址：https://lbs.amap.com → 创建应用 → Web服务
AMAP_WEB_KEY=your-amap-web-key-here

# ---- 服务配置 ----
AGENT_PORT=3201
# 是否在前端展示 Agent 思考过程（开发环境建议 true）
SHOW_THINKING=true
# 强制 Demo 模式（无需 LLM API Key，使用内置 8 城数据）。
# 未配置 LLM_API_KEY 时也会自动进入 Demo 模式，一般无需显式设置。
# DEMO_MODE=true
